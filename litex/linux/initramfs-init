#!/bin/busybox sh
# Initramfs for the first boot of the ADP-XC7K160: a shell on the console and the network, to write
# the SD card (litex/linux/README.md). The kernel sets the address of eth0 from ip= in the bootargs
# of the DTS. If the bootargs have no ip=, adpip=ADDRESS/PREFIX gives one here.
/bin/busybox --install -s /bin
mkdir -p /proc /sys /dev /tmp /mnt
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
for a in $(cat /proc/cmdline); do case "$a" in adpip=*) IP="${a#adpip=}";; esac; done
ip link set eth0 up
[ -n "$IP" ] && ip addr add "$IP" dev eth0
echo "initramfs ready: $(uname -r), eth0 ${IP:-no address}"
exec setsid cttyhack sh
