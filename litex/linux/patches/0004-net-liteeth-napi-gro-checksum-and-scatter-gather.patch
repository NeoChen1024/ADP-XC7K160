From: ADP-XC7K160 board notes
Subject: [PATCH] net: liteeth: NAPI, GRO, checksums and scatter-gather

On a NaxRiscv SoC at 100 MHz each CPU access to the slot memory of LiteEth
takes about 20 cycles, and one frame of 1514 bytes takes about 50 us to copy.
The driver received one frame for each interrupt, in the interrupt handler,
and the stack summed each frame again. TCP reached 71 Mbit/s in and 57 Mbit/s
out, with one CPU busy.

- Receive in a NAPI poll, all full slots in one poll, and give the frames to
  GRO. The receive event is a level: the interrupt masks it until the poll
  ends, also when the poll is scheduled already, or the line stays high.
- Sum each frame while it is copied. The CPU waits for each access to the
  slot, so the sum costs no time. Received frames get CHECKSUM_COMPLETE. For
  transmission the driver sets NETIF_F_HW_CSUM and NETIF_F_SG, and writes the
  checksum into the slot after the copy.
- Copy a frame to a slot from the pieces of the skb, with aligned loads and
  shifts. Misaligned loads trap on this CPU, and memcpy() copies bytes when
  the two addresses are not aligned alike.
- Enable the event of a sent frame only while the queue is stopped, and wake
  the queue in the poll, so that the transmissions after a wake run on the CPU
  of the poll.

--- a/drivers/net/ethernet/litex/litex_liteeth.c
+++ b/drivers/net/ethernet/litex/litex_liteeth.c
@@ -12,6 +12,8 @@
 #include <linux/module.h>
 #include <linux/of_net.h>
 #include <linux/platform_device.h>
+#include <linux/udp.h>
+#include <net/checksum.h>
 
 #define LITEETH_WRITER_SLOT       0x00
 #define LITEETH_WRITER_LENGTH     0x04
@@ -36,11 +38,13 @@
 #define LITEETH_MDIO_R            0x0C
 
 #define DRV_NAME	"liteeth"
+#define LITEETH_NAPI_WEIGHT	16
 
 struct liteeth {
 	void __iomem *base;
 	struct net_device *netdev;
 	struct device *dev;
+	struct napi_struct napi;
 	u32 slot_size;
 
 	/* Tx */
@@ -54,59 +58,231 @@
 	void __iomem *rx_base;
 };
 
-static int liteeth_rx(struct net_device *netdev)
+/*
+ * Copy a frame from a slot, and sum it as csum_partial() does. Each read of the
+ * slot memory waits for the bus, so the sum costs no time. The slots start on
+ * an 8-byte boundary.
+ */
+static __wsum liteeth_copy_csum(void *dst, const void __iomem *src, unsigned int len)
 {
-	struct liteeth *priv = netdev_priv(netdev);
+	unsigned int i;
+	__wsum csum;
+	u64 sum = 0;
+
+	for (i = 0; i + 8 <= len; i += 8) {
+		u64 v = __raw_readq(src + i);
+
+		put_unaligned(v, (u64 *)(dst + i));
+		sum += v;
+		sum += (sum < v);
+	}
+	csum = csum_add((__force __wsum)(u32)sum, (__force __wsum)(u32)(sum >> 32));
+	if (i < len) {
+		memcpy_fromio(dst + i, src + i, len - i);
+		csum = csum_block_add(csum, csum_partial(dst + i, len - i, 0), i);
+	}
+	return csum;
+}
+
+/* Receive one frame from the oldest full slot, and release the slot. */
+static void liteeth_rx(struct liteeth *priv)
+{
+	struct net_device *netdev = priv->netdev;
 	struct sk_buff *skb;
 	unsigned char *data;
+	__wsum csum;
 	u8 rx_slot;
 	int len;
 
 	rx_slot = litex_read8(priv->base + LITEETH_WRITER_SLOT);
 	len = litex_read32(priv->base + LITEETH_WRITER_LENGTH);
 
-	if (len == 0 || len > 2048)
+	if (len < ETH_HLEN || len > priv->slot_size)
 		goto rx_drop;
 
-	skb = netdev_alloc_skb_ip_align(netdev, len);
-	if (!skb) {
-		netdev_err(netdev, "couldn't get memory\n");
+	skb = napi_alloc_skb(&priv->napi, len);
+	if (!skb)
 		goto rx_drop;
-	}
 
 	data = skb_put(skb, len);
-	memcpy_fromio(data, priv->rx_base + rx_slot * priv->slot_size, len);
+	csum = liteeth_copy_csum(data, priv->rx_base + rx_slot * priv->slot_size, len);
+	litex_write8(priv->base + LITEETH_WRITER_EV_PENDING, 1);
+
+	/* The sum of CHECKSUM_COMPLETE starts after the Ethernet header. */
+	skb->csum = csum_sub(csum, csum_partial(data, ETH_HLEN, 0));
+	skb->ip_summed = CHECKSUM_COMPLETE;
 	skb->protocol = eth_type_trans(skb, netdev);
 
 	dev_sw_netstats_rx_add(netdev, len);
-
-	return netif_rx(skb);
+	napi_gro_receive(&priv->napi, skb);
+	return;
 
 rx_drop:
+	litex_write8(priv->base + LITEETH_WRITER_EV_PENDING, 1);
 	netdev->stats.rx_dropped++;
 	netdev->stats.rx_errors++;
+}
+
+/*
+ * Writes a frame into a slot with 8-byte writes, from the pieces of an skb,
+ * and sums the words as csum_partial() does. The pieces can start at any
+ * address. Misaligned loads trap on this CPU, and memcpy() copies bytes if the
+ * addresses are not aligned alike. Thus the writer loads aligned words, and
+ * shifts them into place.
+ */
+struct liteeth_slot_writer {
+	void __iomem *dst;
+	u64 acc;		/* the next word, with n bytes in its low end */
+	unsigned int n;
+	u64 sum;
+};
+
+static inline void liteeth_slot_put(struct liteeth_slot_writer *w, u64 v)
+{
+	__raw_writeq(v, w->dst);
+	w->dst += 8;
+	w->sum += v;
+	w->sum += (w->sum < v);
+}
+
+static inline void liteeth_slot_byte(struct liteeth_slot_writer *w, u8 b)
+{
+	w->acc |= (u64)b << (8 * w->n);
+	if (++w->n == 8) {
+		liteeth_slot_put(w, w->acc);
+		w->acc = 0;
+		w->n = 0;
+	}
+}
+
+static void liteeth_slot_write(struct liteeth_slot_writer *w, const u8 *src, unsigned int len)
+{
+	while (len && !IS_ALIGNED((unsigned long)src, 8)) {
+		liteeth_slot_byte(w, *src++);
+		len--;
+	}
+	if (w->n == 0) {
+		for (; len >= 8; src += 8, len -= 8)
+			liteeth_slot_put(w, *(const u64 *)src);
+	} else {
+		unsigned int sh = 8 * w->n;
+
+		for (; len >= 8; src += 8, len -= 8) {
+			u64 v = *(const u64 *)src;
+
+			liteeth_slot_put(w, w->acc | (v << sh));
+			w->acc = v >> (64 - sh);
+		}
+	}
+	while (len--)
+		liteeth_slot_byte(w, *src++);
+}
+
+/* Write the skb into a slot, and return the sum of the frame from its start. */
+static __wsum liteeth_slot_write_skb(void __iomem *dst, struct sk_buff *skb)
+{
+	struct liteeth_slot_writer w = { .dst = dst };
+	int i;
+
+	liteeth_slot_write(&w, skb->data, skb_headlen(skb));
+	for (i = 0; i < skb_shinfo(skb)->nr_frags; i++) {
+		const skb_frag_t *f = &skb_shinfo(skb)->frags[i];
+
+		liteeth_slot_write(&w, skb_frag_address(f), skb_frag_size(f));
+	}
+	/* The bytes after the end of the frame are 0, and do not change the sum. */
+	if (w.n)
+		liteeth_slot_put(&w, w.acc);
+	return csum_add((__force __wsum)(u32)w.sum, (__force __wsum)(u32)(w.sum >> 32));
+}
+
+/*
+ * Wake a stopped queue in the context of the poll, so that the transmissions
+ * after the wake run on the CPU of the poll. If the FIFO is still full, wait
+ * for the event of the next sent frame.
+ */
+static void liteeth_tx_complete(struct liteeth *priv)
+{
+	if (!netif_queue_stopped(priv->netdev))
+		return;
+	if (!litex_read8(priv->base + LITEETH_READER_READY)) {
+		litex_write8(priv->base + LITEETH_READER_EV_PENDING, 1);
+		litex_write8(priv->base + LITEETH_READER_EV_ENABLE, 1);
+		if (!litex_read8(priv->base + LITEETH_READER_READY))
+			return;
+		litex_write8(priv->base + LITEETH_READER_EV_ENABLE, 0);
+	}
+	netif_wake_queue(priv->netdev);
+}
+
+static int liteeth_poll(struct napi_struct *napi, int budget)
+{
+	struct liteeth *priv = container_of(napi, struct liteeth, napi);
+	int done = 0;
+
+	liteeth_tx_complete(priv);
+
+	while (done < budget &&
+	       litex_read8(priv->base + LITEETH_WRITER_EV_PENDING)) {
+		liteeth_rx(priv);
+		done++;
+	}
+
+	/* A frame that comes after the last read sets the level event again. */
+	if (done < budget && napi_complete_done(napi, done))
+		litex_write8(priv->base + LITEETH_WRITER_EV_ENABLE, 1);
+
+	return done;
+}
+
+/*
+ * Stop the queue if the command FIFO of the MAC is full. The event of a sent
+ * frame is enabled only while the queue is stopped, so that a running queue
+ * costs no interrupts.
+ */
+static bool liteeth_tx_stop_if_full(struct liteeth *priv)
+{
+	if (litex_read8(priv->base + LITEETH_READER_READY))
+		return false;
+
+	netif_stop_queue(priv->netdev);
+	litex_write8(priv->base + LITEETH_READER_EV_PENDING, 1);
+	litex_write8(priv->base + LITEETH_READER_EV_ENABLE, 1);
 
-	return NET_RX_DROP;
+	/* A frame that ended before the enable gave no event: read the state again. */
+	if (!litex_read8(priv->base + LITEETH_READER_READY))
+		return true;
+	litex_write8(priv->base + LITEETH_READER_EV_ENABLE, 0);
+	netif_wake_queue(priv->netdev);
+	return false;
 }
 
 static irqreturn_t liteeth_interrupt(int irq, void *dev_id)
 {
 	struct net_device *netdev = dev_id;
 	struct liteeth *priv = netdev_priv(netdev);
+	bool poll = false;
 	u8 reg;
 
+	/*
+	 * Both events go to the poll, and stay masked until the poll enables
+	 * them. Mask them also when the poll is scheduled already: the poll can
+	 * enable an event after napi_complete_done(), before this interrupt
+	 * schedules the poll again. The receive event is a level, and its line
+	 * would stay high.
+	 */
 	reg = litex_read8(priv->base + LITEETH_READER_EV_PENDING);
 	if (reg) {
-		if (netif_queue_stopped(netdev))
-			netif_wake_queue(netdev);
+		litex_write8(priv->base + LITEETH_READER_EV_ENABLE, 0);
 		litex_write8(priv->base + LITEETH_READER_EV_PENDING, reg);
+		poll = true;
 	}
-
-	reg = litex_read8(priv->base + LITEETH_WRITER_EV_PENDING);
-	if (reg) {
-		liteeth_rx(netdev);
-		litex_write8(priv->base + LITEETH_WRITER_EV_PENDING, reg);
+	if (litex_read8(priv->base + LITEETH_WRITER_EV_PENDING)) {
+		litex_write8(priv->base + LITEETH_WRITER_EV_ENABLE, 0);
+		poll = true;
 	}
+	if (poll)
+		napi_schedule(&priv->napi);
 
 	return IRQ_HANDLED;
 }
@@ -126,9 +302,10 @@
 		return err;
 	}
 
-	/* Enable IRQs */
+	napi_enable(&priv->napi);
+
+	/* Enable the receive event. liteeth_tx_stop_if_full() enables the other. */
 	litex_write8(priv->base + LITEETH_WRITER_EV_ENABLE, 1);
-	litex_write8(priv->base + LITEETH_READER_EV_ENABLE, 1);
 
 	netif_carrier_on(netdev);
 	netif_start_queue(netdev);
@@ -147,6 +324,7 @@
 	litex_write8(priv->base + LITEETH_READER_EV_ENABLE, 0);
 
 	free_irq(netdev->irq, netdev);
+	napi_disable(&priv->napi);
 
 	return 0;
 }
