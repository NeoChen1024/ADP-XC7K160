 	/* Reject oversize packets */
 	if (unlikely(skb->len > priv->slot_size)) {
@@ -182,8 +351,23 @@
 		return NETDEV_TX_OK;
 	}
 
+	/*
+	 * For CHECKSUM_PARTIAL the sum of the copy gives the checksum, which goes
+	 * into the slot after the copy.
+	 */
 	txbuffer = priv->tx_base + priv->tx_slot * priv->slot_size;
-	memcpy_toio(txbuffer, skb->data, skb->len);
+	csum = liteeth_slot_write_skb(txbuffer, skb);
+	if (skb->ip_summed == CHECKSUM_PARTIAL) {
+		int start = skb_checksum_start_offset(skb);
+		__sum16 check;
+
+		/* The sum from start: remove the headers, and align it to start. */
+		csum = csum_shift(csum_sub(csum, csum_partial(skb->data, start, 0)), start);
+		check = csum_fold(csum);
+		if (check == 0 && skb->csum_offset == offsetof(struct udphdr, check))
+			check = CSUM_MANGLED_0;
+		__raw_writew((__force u16)check, txbuffer + start + skb->csum_offset);
+	}
 	litex_write8(priv->base + LITEETH_READER_SLOT, priv->tx_slot);
 	litex_write16(priv->base + LITEETH_READER_LENGTH, skb->len);
 	litex_write8(priv->base + LITEETH_READER_START, 1);
@@ -192,6 +376,7 @@
 
 	priv->tx_slot = (priv->tx_slot + 1) % priv->num_tx_slots;
 	dev_kfree_skb_any(skb);
+	liteeth_tx_stop_if_full(priv);
 
 	return NETDEV_TX_OK;
 }
@@ -295,6 +480,10 @@
 		eth_hw_addr_random(netdev);
 
 	netdev->netdev_ops = &liteeth_netdev_ops;
+	/* The driver sums each frame while it copies it to or from a slot. */
+	netdev->features |= NETIF_F_RXCSUM | NETIF_F_SG | NETIF_F_HW_CSUM;
+	netdev->hw_features |= NETIF_F_RXCSUM | NETIF_F_SG | NETIF_F_HW_CSUM;
+	netif_napi_add_weight(netdev, &priv->napi, liteeth_poll, LITEETH_NAPI_WEIGHT);
 
 	err = register_netdev(netdev);
 	if (err) {
