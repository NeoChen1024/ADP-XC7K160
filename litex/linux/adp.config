# Kernel config fragment for the NaxRiscv SoC of README section 15. Merge it over the defconfig:
#   make ARCH=riscv O=/path/to/linux-build defconfig
#   scripts/kconfig/merge_config.sh -m -O /path/to/linux-build /path/to/linux-build/.config adp.config
#   make ARCH=riscv O=/path/to/linux-build olddefconfig
# Then check that each line below is in .config: a symbol with a missing dependency is dropped.

CONFIG_LOCALVERSION="-adp"
CONFIG_LOCALVERSION_AUTO=n

# The peripherals of the LiteX SoC.
CONFIG_SERIAL_LITEUART=y
CONFIG_SERIAL_LITEUART_CONSOLE=y
CONFIG_LITEX_SOC_CONTROLLER=y
CONFIG_LITEX_LITEETH=y
CONFIG_MMC_LITEX=y

# The SoC is none of the platforms of other vendors.
CONFIG_ARCH_ANDES=n
CONFIG_ARCH_CANAAN=n
CONFIG_ARCH_MICROCHIP=n
CONFIG_ARCH_SIFIVE=n
CONFIG_ARCH_SOPHGO=n
CONFIG_ARCH_SPACEMIT=n
CONFIG_SOC_STARFIVE=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_THEAD=n
CONFIG_ARCH_VIRT=n

# The SoC has no PCIe, USB or display. Sound stays, for the AC97 codec of the board (section 11).
CONFIG_PCI=n
CONFIG_USB_SUPPORT=n
CONFIG_DRM=n

# The root file system: F2FS with LZ4 compression, built in.
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
CONFIG_F2FS_FS_LZ4HC=y
CONFIG_F2FS_FS_ZSTD=y

# Swap on the SD card, with zswap (LZ4) in front of it.
CONFIG_SWAP=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y

# Basic functions.
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_LZO=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_WIREGUARD=y

# A firewall: the board is on the LAN with SSH after each power-on.
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y

# A CPU of 100 MHz: fewer timer interrupts, and a little preemption for interactive use.
CONFIG_HZ_100=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_PSI=y

CONFIG_CONSOLE_LOGLEVEL_DEFAULT=7
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
