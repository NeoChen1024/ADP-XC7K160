## =============================================================================
## Master XDC for Andes AndeShape ADP-XC7K160 / ADP-XC7K410 (PCB: ADP-XC7KFF676)
## FPGA on the green PCB (ADP-XC7K160): XC7K160T in FBG676, marked speed grade -1C.
## Vivado part xc7k160tfbg676-1 (or -2: see README.md, "Speed grade").
##
## Pin data: AndeShape ADP-XC7K160/410 User Manual UM098 v1.9 (2025-06-19),
##           section 2.11 "FPGA Pin Assign". Generated by script, not hand-typed,
##           and every pin checked against Vivado's package for its bank.
## IOSTANDARDs are NOT in the manual. They are derived from the bank voltages
## in the manual's block diagram (Figure 3):
##   bank 0/12/13/14/15 = 3.3V, bank 16 = adjustable (SW11),
##   bank 32/33 = 1.5V, bank 34 = 1.8V, bank 115/116 = MGT
## Sections marked [board] have run on the board with the standards given here;
## the others are a starting point only. pins.csv has the same, pin by pin.
##
## Usage (Digilent-style): uncomment the lines for the ports your top level
## uses and rename the ports to match. Port names follow the manual's signal
## names, with numbered signals turned into buses.
## =============================================================================

## ---- Configuration (active) -------------------------------------------------
## Bank 0 is 3.3V; the board configures from parallel NOR in BPI x16 mode (the mode pins read 010).
## The first two lines are in every design that ran on the board. CONFIG_MODE only matters to a
## bitstream meant for the flash, and none was ever written there from here: it is as the manual has it.
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
set_property CONFIG_MODE BPI16 [current_design]
## A compressed bitstream loads faster over a slow JTAG cable (2.5 MB instead of 6.7 MB for a seventh
## of the part in use).
#set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]

## ---- Bank 16 I/O standard (active) ------------------------------------------
## VCCO_16 is selected by DIP switch SW11: 3.3V / 2.5V / 1.8V.
## Set this to match the switch: LVCMOS33, LVCMOS25 or LVCMOS18.
set BANK16_IOSTD LVCMOS33

## ---- Clocks ---- [board: OSCCLK1 and SYSCLK]
## X1: 20 MHz system clock, X3: 20 MHz (NC in the manual's clock diagram), X2: 32.768 kHz RTC,
## U22: 200 MHz LVDS oscillator (bank 33, for DDR3/MIG). All four are on SRCC pins.
## SYSCLK is DIFF_SSTL15 here because that is what ran: MIG's own constraints set it so, the way
## the KC705 does. The manual's diagram says LVDS, which a 1.5 V HP bank can take as an input
## without DIFF_TERM; that was not tried. With MIG in the design, leave SYSCLK to MIG's XDC.
#set_property -dict { PACKAGE_PIN G24  IOSTANDARD LVCMOS33    } [get_ports { OSCCLK1 }]            ; # bank 14, X1.3
#set_property -dict { PACKAGE_PIN D23  IOSTANDARD LVCMOS33    } [get_ports { OSCCLK2 }]            ; # bank 14, X3.3
#set_property -dict { PACKAGE_PIN H17  IOSTANDARD LVCMOS33    } [get_ports { RTC_32K }]            ; # bank 15, X2.3
#set_property -dict { PACKAGE_PIN AA10 IOSTANDARD DIFF_SSTL15 } [get_ports { SYSCLK_P }]           ; # bank 33, U22.4
#set_property -dict { PACKAGE_PIN AB10 IOSTANDARD DIFF_SSTL15 } [get_ports { SYSCLK_N }]           ; # bank 33, U22.5
#create_clock -name osc_20m  -period 50.000    [get_ports { OSCCLK1 }]
#create_clock -name sys_200m -period 5.000     [get_ports { SYSCLK_P }]
#create_clock -name rtc_32k  -period 30517.578 [get_ports { RTC_32K }]

## ---- Reset / power control ----
## PORn from U18, SYS_RSTn from U19 (HW_RST_SW1), GPIO0_ENn from PWR_SW1. None was used so far:
## polarity by the names, not checked.
#set_property -dict { PACKAGE_PIN U21  IOSTANDARD LVCMOS33    } [get_ports { PORn }]               ; # bank 12, U18.2
#set_property -dict { PACKAGE_PIN U22  IOSTANDARD LVCMOS33    } [get_ports { SYS_RSTn }]           ; # bank 12, U19.2
#set_property -dict { PACKAGE_PIN K21  IOSTANDARD LVCMOS33    } [get_ports { GPIO0_ENn }]          ; # bank 14, PWR_SW1.2/PWR_SW1.4

## ---- Push buttons SW1..SW8 (GPIO1..GPIO8) ---- [board: SW1..SW4]
## A button reads low while pressed, and the board has no pull-up for SW1..SW4: add PULLUP TRUE,
## as in  set_property -dict { PACKAGE_PIN E21 IOSTANDARD LVCMOS33 PULLUP TRUE } [get_ports ...]
## SW5..SW8 are on bank 16 (VCCO set by SW11) and were not tried.
#set_property -dict { PACKAGE_PIN E21  IOSTANDARD LVCMOS33    } [get_ports { GPIO[1] }]            ; # bank 14, SW1.1, manual: GPIO1
#set_property -dict { PACKAGE_PIN F24  IOSTANDARD LVCMOS33    } [get_ports { GPIO[2] }]            ; # bank 14, SW2.1, manual: GPIO2
#set_property -dict { PACKAGE_PIN J21  IOSTANDARD LVCMOS33    } [get_ports { GPIO[3] }]            ; # bank 14, SW3.1, manual: GPIO3
#set_property -dict { PACKAGE_PIN L23  IOSTANDARD LVCMOS33    } [get_ports { GPIO[4] }]            ; # bank 14, SW4.1, manual: GPIO4
#set_property -dict [list PACKAGE_PIN A13  IOSTANDARD $BANK16_IOSTD] [get_ports { GPIO[5] }]       ; # bank 16, SW5.1, manual: GPIO5
#set_property -dict [list PACKAGE_PIN A12  IOSTANDARD $BANK16_IOSTD] [get_ports { GPIO[6] }]       ; # bank 16, SW6.1, manual: GPIO6
#set_property -dict [list PACKAGE_PIN J14  IOSTANDARD $BANK16_IOSTD] [get_ports { GPIO[7] }]       ; # bank 16, SW7.1, manual: GPIO7
#set_property -dict [list PACKAGE_PIN D9   IOSTANDARD $BANK16_IOSTD] [get_ports { GPIO[8] }]       ; # bank 16, SW8.1, manual: GPIO8

## ---- 7-segment displays 7SEG1 / 7SEG2 ----
## [board] Common anode: a low lights a segment. 7SEG2 was used as the left-hand digit.
## P is the decimal point.
#set_property -dict { PACKAGE_PIN V26  IOSTANDARD LVCMOS33    } [get_ports { SEG1_A }]             ; # bank 12, 7SEG1.10, manual: 7SEG1_A
#set_property -dict { PACKAGE_PIN W25  IOSTANDARD LVCMOS33    } [get_ports { SEG1_B }]             ; # bank 12, 7SEG1.9, manual: 7SEG1_B
#set_property -dict { PACKAGE_PIN W26  IOSTANDARD LVCMOS33    } [get_ports { SEG1_C }]             ; # bank 12, 7SEG1.8, manual: 7SEG1_C
#set_property -dict { PACKAGE_PIN V21  IOSTANDARD LVCMOS33    } [get_ports { SEG1_D }]             ; # bank 12, 7SEG1.5, manual: 7SEG1_D
#set_property -dict { PACKAGE_PIN W21  IOSTANDARD LVCMOS33    } [get_ports { SEG1_E }]             ; # bank 12, 7SEG1.4, manual: 7SEG1_E
#set_property -dict { PACKAGE_PIN AA25 IOSTANDARD LVCMOS33    } [get_ports { SEG1_F }]             ; # bank 12, 7SEG1.2, manual: 7SEG1_F
#set_property -dict { PACKAGE_PIN AB25 IOSTANDARD LVCMOS33    } [get_ports { SEG1_G }]             ; # bank 12, 7SEG1.3, manual: 7SEG1_G
#set_property -dict { PACKAGE_PIN W23  IOSTANDARD LVCMOS33    } [get_ports { SEG1_P }]             ; # bank 12, 7SEG1.7, manual: 7SEG1_P
#set_property -dict { PACKAGE_PIN W24  IOSTANDARD LVCMOS33    } [get_ports { SEG2_A }]             ; # bank 12, 7SEG2.10, manual: 7SEG2_A
#set_property -dict { PACKAGE_PIN AB26 IOSTANDARD LVCMOS33    } [get_ports { SEG2_B }]             ; # bank 12, 7SEG2.9, manual: 7SEG2_B
#set_property -dict { PACKAGE_PIN AC26 IOSTANDARD LVCMOS33    } [get_ports { SEG2_C }]             ; # bank 12, 7SEG2.8, manual: 7SEG2_C
#set_property -dict { PACKAGE_PIN Y25  IOSTANDARD LVCMOS33    } [get_ports { SEG2_D }]             ; # bank 12, 7SEG2.5, manual: 7SEG2_D
#set_property -dict { PACKAGE_PIN Y26  IOSTANDARD LVCMOS33    } [get_ports { SEG2_E }]             ; # bank 12, 7SEG2.4, manual: 7SEG2_E
#set_property -dict { PACKAGE_PIN AD21 IOSTANDARD LVCMOS33    } [get_ports { SEG2_F }]             ; # bank 12, 7SEG2.2, manual: 7SEG2_F
#set_property -dict { PACKAGE_PIN AD23 IOSTANDARD LVCMOS33    } [get_ports { SEG2_G }]             ; # bank 12, 7SEG2.3, manual: 7SEG2_G
#set_property -dict { PACKAGE_PIN AB24 IOSTANDARD LVCMOS33    } [get_ports { SEG2_P }]             ; # bank 12, 7SEG2.7, manual: 7SEG2_P

## ---- UART (U15 RS-232 transceiver, COM1) ---- [board: S1]
## COM1, the DB9, is S1. S1_TXD is the board's output and S1_RXD its input. S1_CTS is an input
## that carries the host's RTS (low while the host asserts it, which a PC does while the port is
## open); S1_RTS is an output, and low asserts the host's CTS. Through U15 both directions were
## exact up to 625000 baud; board to host fails from 750000. Nothing of S2 reached the DB9.
## Andes' own console is 38400 8N1.
#set_property -dict { PACKAGE_PIN T17  IOSTANDARD LVCMOS33    } [get_ports { S1_TXD }]             ; # bank 13, U15.14
#set_property -dict { PACKAGE_PIN R18  IOSTANDARD LVCMOS33    } [get_ports { S1_RXD }]             ; # bank 13, U15.19
#set_property -dict { PACKAGE_PIN P18  IOSTANDARD LVCMOS33    } [get_ports { S1_CTS }]             ; # bank 13, U15.18
#set_property -dict { PACKAGE_PIN U16  IOSTANDARD LVCMOS33    } [get_ports { S1_RTS }]             ; # bank 13, U15.13
#set_property -dict { PACKAGE_PIN D25  IOSTANDARD LVCMOS33    } [get_ports { S2_TXD }]             ; # bank 14, U15.12
#set_property -dict { PACKAGE_PIN G25  IOSTANDARD LVCMOS33    } [get_ports { S2_RXD }]             ; # bank 14, U15.17

## ---- I2C EEPROM (U16 AT24C128) ----
#set_property -dict { PACKAGE_PIN M25  IOSTANDARD LVCMOS33    } [get_ports { I2C_SCL }]            ; # bank 13, U16.6
#set_property -dict { PACKAGE_PIN L25  IOSTANDARD LVCMOS33    } [get_ports { I2C_SDA }]            ; # bank 13, U16.5

## ---- SPI flash (U17 MX25U1635E, 1.8V, bank 34) ---- [board]
## JEDEC ID C2 25 35, 16 Mbit. As plain SPI: SIO0 is MOSI, SIO1 is MISO, SIO2 is WP#, SIO3 is HOLD#
## (hold both high). Read, erased and programmed from a design at 2.5 MHz.
#set_property -dict { PACKAGE_PIN AC4  IOSTANDARD LVCMOS18    } [get_ports { SPI_SIO[1] }]         ; # bank 34, U17.2, manual: SPI_SO_SIO1
#set_property -dict { PACKAGE_PIN AA5  IOSTANDARD LVCMOS18    } [get_ports { SPI_SCLK }]           ; # bank 34, U17.6
#set_property -dict { PACKAGE_PIN AB5  IOSTANDARD LVCMOS18    } [get_ports { SPI_SIO[2] }]         ; # bank 34, U17.3, manual: SPI_WP#_SIO2
#set_property -dict { PACKAGE_PIN AB6  IOSTANDARD LVCMOS18    } [get_ports { SPI_SIO[3] }]         ; # bank 34, U17.7, manual: SPI_SIO3
#set_property -dict { PACKAGE_PIN AC6  IOSTANDARD LVCMOS18    } [get_ports { SPI_SIO[0] }]         ; # bank 34, U17.5, manual: SPI_SI/SIO0
#set_property -dict { PACKAGE_PIN Y5   IOSTANDARD LVCMOS18    } [get_ports { SPI_CSN }]            ; # bank 34, U17.1

